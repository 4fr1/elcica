# Neon Postgres (wajib untuk migrate & /health)
DATABASE_URL=postgres://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/elcica?sslmode=require

# Server (Render akan set PORT otomatis)
PORT=3000
RUST_LOG=info

# Render deploy hook (opsional, untuk deploy.yml manual)
RENDER_DEPLOY_HOOK=

# Email transaksional (Resend)
RESEND_API_KEY=

# Cloudflare R2 (object storage / upload)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Android signing (base64 keystore + password)
ANDROID_KEYSTORE_B64=
ANDROID_STORE_PASS=
ANDROID_KEY_PASS=
ANDROID_KEY_ALIAS=
